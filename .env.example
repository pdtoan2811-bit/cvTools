# Vercel Blob — create a Blob store in the Vercel dashboard (Storage → Create →
# Blob) and connect it to this project; Vercel injects this automatically.
# Locally: `vercel env pull .env.local`
BLOB_READ_WRITE_TOKEN=

# Optional. Without a token the app falls back to a local .data/ folder so you
# can develop with no cloud setup at all.
